// Nile (Jacobs et al.) as used by NEAT + REIN extensions. Canonical, whitespace-insensitive.
// Validated 2026-09-28 with lark (parser="lalr"): parses 256913/256913 NEAT lines, the REIN
// intents `for endpoint('<ip>') add service('cdn-qoe')`, `for group('students') add middlebox('dpi')`,
// and rejects malformed inputs (set middlebox, missing scope, from without to, unquoted values, allow bandwidth).
// This validates SYNTAX only. What the REIN deployer can actually EXECUTE is a smaller subset
// (CAPABILITIES in nile.py, served at GET /capabilities).
start: "define" "intent" NAME ":" scope action window?

scope: "from" target "to" target        -> from_to
     | "for" target                     -> for_target

target: TARGET_FN "(" STR ")"
TARGET_FN: "endpoint" | "group" | "service" | "traffic"

action: SET_OP qos ("," qos)*           -> qos_action
      | ACL_OP acl ("," acl)*           -> acl_action
      | CHAIN_OP chain ("," chain)*     -> chain_action

SET_OP: "unset" | "set"
qos: "bandwidth" "(" STR "," STR "," STR ")"   -> bandwidth
   | "quota" "(" STR "," STR "," STR ")"       -> quota

ACL_OP: "allow" | "block"
acl: ACL_FN "(" STR ")"
ACL_FN: "traffic" | "service" | "protocol"

CHAIN_OP: "add" | "remove"
chain: CHAIN_FN "(" STR ")"
CHAIN_FN: "middlebox" | "service"       // service(...) = REIN extension, e.g. add service('cdn-qoe')

window: "start" time "end" time
time: TIME_FN "(" STR ")"
TIME_FN: "hour" | "date" | "datetime" | "timestamp"

NAME: /[A-Za-z_][A-Za-z0-9_]*/
STR: /'[^']*'/
%ignore /\s+/
